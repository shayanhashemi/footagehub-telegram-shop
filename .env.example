# Copy to .env. Never commit credentials.
NODE_ENV=development
DATABASE_URL="mysql://footagehub:STRONG_DATABASE_PASSWORD@127.0.0.1:3306/footagehub"
BOT_TOKEN=""
PUBLIC_BASE_URL="http://localhost:3000"
PORT=3000
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="REPLACE_WITH_LONG_RANDOM_PASSWORD"
# At least 32 random characters; generating: openssl rand -hex 32
DOWNLOAD_SIGNING_SECRET="REPLACE_WITH_RANDOM_64_HEX_CHARACTERS"
DOWNLOAD_ALLOWED_HOSTS="dl.footagefx.com"
SESSION_COOKIE_SECURE=false
# Optional: only allow bot operation in this private PRO channel (bot must be admin)

# Absolute path recommended in production; make writable by the node process
MEDIA_DIR="./uploads"
