{
  "name": "footagehub-telegram-shop", "version": "1.0.0", "private": true,
  "type": "module", "engines": {"node": "^20.19.0 || >=22.12.0"},
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "prisma generate && tsc -p tsconfig.server.json && vite build",
    "start": "node dist-server/server/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma db push",
    "db:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0", "bcryptjs": "^3.0.2", "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.2", "express": "^5.1.0", "express-rate-limit": "^8.1.0",
    "grammy": "^1.38.2", "helmet": "^8.1.0", "lucide-react": "^0.468.0",
    "react": "^19.1.1", "react-dom": "^19.1.1", "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6", "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3", "@types/node": "^22.18.6",
    "@types/react": "^19.1.13", "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2", "concurrently": "^9.2.1",
    "prisma": "^6.16.0", "tsx": "^4.20.6", "typescript": "^5.9.2", "vite": "^7.1.7"
  },
  "prisma": {"seed": "tsx prisma/seed.ts"}
}
